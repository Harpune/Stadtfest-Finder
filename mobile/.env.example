# Copy to mobile/.env (git-ignored). Expo inlines EXPO_PUBLIC_* at build time - they are NOT secret.

# Backend base URL. On a physical device use the LAN IP of your machine.
EXPO_PUBLIC_API_URL=http://localhost:8000

# MapTiler Cloud (ADR 0009, 00-docs/40-operations/maptiler.md).
# Empty = offline background style without tiles (no external requests).
EXPO_PUBLIC_MAPTILER_KEY=
EXPO_PUBLIC_MAPTILER_STYLE_DARK=streets-v2-dark
EXPO_PUBLIC_MAPTILER_STYLE_LIGHT=streets-v2

# Domain of shared event links and Android App Links (build time for App Links).
# 00-docs/40-operations/deep-links-domain.md
EXPO_PUBLIC_LINK_HOST=stadtfest.herderstreet.de

# Start the app directly in Storybook.
EXPO_PUBLIC_STORYBOOK_ENABLED=false

# Login (R05, ADR 0003). Issuer must be reachable from the device and equal AUTH_ISSUER of
# the backend (Keycloak writes the requested host into `iss`). On a physical device use the
# LAN IP here AND in the backend .env.
EXPO_PUBLIC_AUTH_ISSUER=http://localhost:58080/realms/stadtfest
EXPO_PUBLIC_AUTH_CLIENT_ID=stadtfest-app
# keycloak (local) | zitadel (production)
EXPO_PUBLIC_AUTH_IDP=keycloak
# Keycloak: IdP aliases; Zitadel: IdP IDs of Apple/Google (00-docs/40-operations/zitadel.md).
EXPO_PUBLIC_AUTH_APPLE_IDP=apple
EXPO_PUBLIC_AUTH_GOOGLE_IDP=google
# Zitadel only: project ID, adds the API audience to the access token.
EXPO_PUBLIC_AUTH_PROJECT_ID=
