# Copy to mobile/.env (git-ignored). Expo inlines EXPO_PUBLIC_* at build time - they are NOT secret.

# Backend base URL. On a physical device use the LAN IP of your machine.
EXPO_PUBLIC_API_URL=http://localhost:8000

# MapTiler Cloud (ADR 0009, 00-docs/40-operations/maptiler.md).
# Empty = offline background style without tiles (no external requests).
EXPO_PUBLIC_MAPTILER_KEY=
EXPO_PUBLIC_MAPTILER_STYLE_DARK=streets-v2-dark
EXPO_PUBLIC_MAPTILER_STYLE_LIGHT=streets-v2

# Domain of shared event links and Android App Links (build time for App Links).
# 00-docs/40-operations/deep-links-domain.md
EXPO_PUBLIC_LINK_HOST=stadtfest.herderstreet.de

# Start the app directly in Storybook.
EXPO_PUBLIC_STORYBOOK_ENABLED=false
