# Copy to `.env` and adjust. Every variable used by the backend is documented here.
# `.env` is git-ignored; never commit real secrets.

# --- General -----------------------------------------------------------------
# dev | test | prod. Fake adapters are only allowed in dev and test.
ENV=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json (default, machine-readable) | console (human-readable, local development)
LOG_FORMAT=console

# --- Database (PostgreSQL + PostGIS) -------------------------------------------
# SQLAlchemy URL with the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://stadtfest:stadtfest@localhost:55432/stadtfest

# --- Redis (queue + cache) -----------------------------------------------------
REDIS_URL=redis://localhost:56379/0

# --- Geocoding (ADR 0006) --------------------------------------------------------
# nominatim (self-hosted, required in prod) | fake (fixed places, dev/test only)
GEOCODING_PROVIDER=fake
# Base URL of the self-hosted Nominatim. Required for GEOCODING_PROVIDER=nominatim.
# Local optional instance: docker compose -f infra/compose.dev.yaml --profile geo up -d
NOMINATIM_URL=http://localhost:58088
# Request timeout in seconds.
GEOCODING_TIMEOUT_SECONDS=3

# --- Authentication (flow B, ADR 0003) -------------------------------------------
# Expected `iss` of access tokens. Must match the URL the app logs in at (Keycloak puts the
# requested host into `iss`). Local: Keycloak realm; prod: Zitadel instance URL (https).
AUTH_ISSUER=http://localhost:58080/realms/stadtfest
# Expected `aud` of access tokens.
AUTH_AUDIENCE=stadtfest-api
# JWKS endpoint. Optional: discovered via $AUTH_ISSUER/.well-known/openid-configuration.
# AUTH_JWKS_URL=http://localhost:58080/realms/stadtfest/protocol/openid-connect/certs
# Claim with the roles. Keycloak: realm_access.roles; Zitadel: urn:zitadel:iam:org:project:roles
AUTH_ROLES_CLAIM=realm_access.roles
# Tolerated clock skew for exp/nbf in seconds.
AUTH_LEEWAY_SECONDS=30
# Timeout for JWKS and IdP admin requests in seconds.
AUTH_TIMEOUT_SECONDS=5

# --- IdP admin (account deletion, R05-US6) ----------------------------------------
# keycloak (local) | zitadel (prod) | fake (no-op, dev/test only)
IDP_ADMIN_PROVIDER=keycloak
# keycloak only: confidential client with realm-management/manage-users (dev realm values).
IDP_ADMIN_CLIENT_ID=stadtfest-admin
IDP_ADMIN_CLIENT_SECRET=stadtfest-dev-admin-secret
# zitadel only: personal access token of the service user (00-docs/40-operations/zitadel.md).
# IDP_ADMIN_TOKEN=

# --- Object storage for event images (R08, ADR 0007) -----------------------------
# S3 endpoint the backend talks to (local SeaweedFS from infra/compose.dev.yaml).
S3_ENDPOINT_URL=http://localhost:58333
# Endpoint inside signed upload URLs, if the app reaches the storage under another host.
# Local Android device: `adb reverse tcp:58333 tcp:58333` makes localhost work.
# S3_PRESIGN_ENDPOINT_URL=
# Public read URL of the bucket (anonymous read on public/ only); https in prod.
S3_PUBLIC_BASE_URL=http://localhost:58333/stadtfest-images
S3_BUCKET=stadtfest-images
S3_REGION=eu-central-1
# Dev identity from infra/dev/seaweedfs/s3.json; in prod from the storage provider.
S3_ACCESS_KEY_ID=stadtfest-dev
S3_SECRET_ACCESS_KEY=stadtfest-dev-secret
S3_TIMEOUT_SECONDS=10

# --- AI search (R10, flow C) ----------------------------------------------------------
# One generic adapter (Pydantic AI, ADR 0012); switching provider needs only these values.
# mistral (EU, default in prod) | ollama (self-hosted) | openai | anthropic | google (Gemini)
# (non-EU, ADR 0014)
# | fake (three fixed finds, dev/test only)
LLM_PROVIDER=fake
LLM_MODEL=mistral-large-latest
# Not needed for ollama/fake. Never commit a real key.
# LLM_API_KEY=
# Optional endpoint, e.g. http://ollama:11434/v1 for a self-hosted Ollama.
# LLM_BASE_URL=
# Web search tool of the LLM (ADR 0013): searxng (self-hosted, default in prod)
# | brave (paid API, non-EU) | fake (dev/test only). See 00-docs/40-operations/web-suche.md.
WEB_SEARCH_PROVIDER=fake
# SearXNG instance; locally `docker compose -f infra/compose.dev.yaml --profile search up -d`.
# WEB_SEARCH_BASE_URL=http://localhost:58089
# Brave Search subscription token (brave only). Never commit a real key.
# WEB_SEARCH_API_KEY=
AI_SEARCH_RADIUS_KM=25
# Searches per moderator and day; 0 stops the AI search.
AI_SEARCH_DAILY_LIMIT=10
AI_SEARCH_MAX_TOOL_CALLS=8
AI_SEARCH_TIMEOUT_S=300

# --- Local dependency ports (infra/compose.dev.yaml) ---------------------------
# Host ports of the local stack. Chosen outside the defaults to avoid clashes.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
S3_HOST_PORT=58333
KEYCLOAK_HOST_PORT=58080
NOMINATIM_HOST_PORT=58088
SEARXNG_HOST_PORT=58089

# --- API server ----------------------------------------------------------------
API_PORT=8000
