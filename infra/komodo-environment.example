# Production environment of the backend containers (api, worker, mcp, migrate) in the HomeLab
# stack `stadtfest` (github.com/Harpune/HomeLab, stacks/stadtfest/, ADR 0019).
#
# This file is the contract between the app and the lab, checked in CI against the backend
# settings (backend/tests/unit/test_production_config.py): every backend variable appears
# here with its production value or source. In HomeLab
#   - section A is set by stacks/stadtfest/compose.yaml (derived from ${DOMAIN} and the
#     stack's container names) and does NOT go into the stack environment,
#   - section B is the `environment` of the `stadtfest` stack in komodo/homelab/resources.toml
#     (literals) with secrets as Komodo variables [[STADTFEST_…]], documented again in
#     stacks/stadtfest/.env.example.
# Guide with the source of every value: 00-docs/40-operations/deployment-komodo.md.
# Example hosts assume DOMAIN=herderstreet.de.

# === A. Set by the HomeLab compose file (not in the stack environment) ====================
ENV=prod
LOG_FORMAT=json
DATABASE_URL=postgresql+asyncpg://stadtfest:[[STADTFEST_POSTGRES_PASSWORD]]@stadtfest-postgres:5432/stadtfest
REDIS_URL=redis://stadtfest-redis:6379/0
GEOCODING_PROVIDER=nominatim
NOMINATIM_URL=http://stadtfest-nominatim:8080
WEB_SEARCH_BASE_URL=http://stadtfest-searxng:8080
S3_ENDPOINT_URL=http://stadtfest-seaweedfs:8333
# Public hosts, one level below DOMAIN (Cloudflare's certificate covers *.DOMAIN only).
S3_PRESIGN_ENDPOINT_URL=https://stadtfest-bilder.herderstreet.de
S3_PUBLIC_BASE_URL=https://stadtfest-bilder.herderstreet.de/stadtfest-images
MCP_PUBLIC_URL=https://stadtfest-mcp.herderstreet.de
DEEP_LINK_BASE_URL=https://stadtfest.herderstreet.de
MCP_HOST=0.0.0.0
MCP_PORT=8001

# === B. Stack environment (resources.toml; secrets as Komodo variables) ===================
LOG_LEVEL=INFO
GEOCODING_TIMEOUT_SECONDS=3

# --- Object storage (SeaweedFS in the stack) ---
S3_BUCKET=stadtfest-images
S3_REGION=eu-central-1
# The stack generates the SeaweedFS identity from these two values (no config file).
S3_ACCESS_KEY_ID=stadtfest-backend
# [secret] openssl rand -hex 32
S3_SECRET_ACCESS_KEY=[[STADTFEST_S3_SECRET_ACCESS_KEY]]
S3_TIMEOUT_SECONDS=10

# --- Authentication: Zitadel Cloud, EU region (zitadel.md) ---
# Instance URL from the Zitadel console (no trailing slash).
AUTH_ISSUER=https://REPLACE_WITH_INSTANCE.eu1.zitadel.cloud
# Resource ID of the project `stadtfest`.
AUTH_AUDIENCE=REPLACE_WITH_PROJECT_ID
AUTH_ROLES_CLAIM=urn:zitadel:iam:org:project:roles
AUTH_LEEWAY_SECONDS=30
AUTH_TIMEOUT_SECONDS=5
IDP_ADMIN_PROVIDER=zitadel
# [secret] Personal access token of the service user `stadtfest-backend` (at most 12 months).
IDP_ADMIN_TOKEN=[[STADTFEST_IDP_ADMIN_TOKEN]]

# --- AI search (ADR 0012-0014): Mistral (EU) or the lab's Ollama ---
LLM_PROVIDER=mistral
LLM_MODEL=mistral-large-latest
# [secret] Mistral API key; empty for ollama.
LLM_API_KEY=[[STADTFEST_LLM_API_KEY]]
# Only for ollama: http://ollama:11434/v1 (worker joins the lab network `ai`).
LLM_BASE_URL=
WEB_SEARCH_PROVIDER=searxng
# [secret] brave only.
WEB_SEARCH_API_KEY=
AI_SEARCH_RADIUS_KM=25
# 0 stops the AI search.
AI_SEARCH_DAILY_LIMIT=10
AI_SEARCH_MAX_TOOL_CALLS=8
AI_SEARCH_TIMEOUT_S=300
AI_SEARCH_PROMPT_VERSION=v4
AI_SEARCH_MAX_PAGE_READS=6

# --- Push (ADR 0016): `direct`, credentials as base64 (push-apns-fcm.md) ---
PUSH_PROVIDER=direct
APNS_KEY_ID=REPLACE_WITH_APNS_KEY_ID
APNS_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID
# [secret] base64 -i AuthKey_<KEYID>.p8 | tr -d '\n'
APNS_KEY_BASE64=[[STADTFEST_APNS_KEY_BASE64]]
APNS_TOPIC=de.stadtfestfinder.app
APNS_SANDBOX=false
FCM_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
# [secret] base64 -i <service-account>.json | tr -d '\n'
FCM_CREDENTIALS_BASE64=[[STADTFEST_FCM_CREDENTIALS_BASE64]]
# Not used with base64 credentials or other providers.
APNS_KEY_PATH=
FCM_CREDENTIALS_PATH=
EXPO_ACCESS_TOKEN=

# --- MCP server (R15, ADR 0018) ---
MCP_OAUTH_SCOPES=openid profile urn:zitadel:iam:org:project:id:REPLACE_WITH_PROJECT_ID:aud
