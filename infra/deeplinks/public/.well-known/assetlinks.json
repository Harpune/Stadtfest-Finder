[{{- if env "ANDROID_CERT_SHA256"}}
  {
    "relation": ["delegate_permission/common.handle_all_urls"],
    "target": {
      "namespace": "android_app",
      "package_name": "de.stadtfestfinder.app",
      "sha256_cert_fingerprints": [{{range $i, $fp := splitList "," (env "ANDROID_CERT_SHA256")}}{{if $i}}, {{end}}"{{trim $fp}}"{{end}}]
    }
  }
{{- end}}
]
