// Grafana Alloy (ADR 0020): ships the logs of the stadtfest stack's containers to Loki.
// Only containers of this compose project are collected, never other stacks on the host.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "stadtfest" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = sys.env("COMPOSE_PROJECT")
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "stadtfest" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.stadtfest.output
  labels     = {"stack" = "stadtfest"}
  forward_to = [loki.process.stadtfest.receiver]
}

// Backend and backup lines are JSON with `event` and `level`; only `level` becomes a label
// (low cardinality). Everything else is parsed at query time with `| json`.
loki.process "stadtfest" {
  stage.json {
    expressions = {level = "level"}
  }

  stage.labels {
    values = {level = ""}
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
