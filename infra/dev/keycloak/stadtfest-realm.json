        "offline_access",
        "user"
      ]
    },
    {
      "username": "moderator@example.test",
      "email": "moderator@example.test",
      "emailVerified": true,
      "firstName": "Mia",
      "lastName": "Moderatorin",
      "enabled": true,
      "attributes": {
        "region": [
          "ostalb"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "stadtfest-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "offline_access",
        "user",
        "moderator"
      ]
    },
    {
      "username": "katadmin@example.test",
      "email": "katadmin@example.test",
      "emailVerified": true,
      "firstName": "Karl",
      "lastName": "Kategorie",
      "enabled": true,
      "attributes": {
        "region": [
          "ostalb"
        ]
      },
      "credentials": [
        {
          "type": "password",
